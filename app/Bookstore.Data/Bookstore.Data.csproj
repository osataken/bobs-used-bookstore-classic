<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net10.0;netstandard2.0</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <RootNamespace>Bookstore.Data</RootNamespace>
    <AssemblyName>Bookstore.Data</AssemblyName>
    <Company>Organization</Company>
    <Product>BobsBookstoreClassic.Data</Product>
    <Copyright>Copyright © Organization 2023</Copyright>
    <ImplicitUsings>disable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <!-- AWS and image packages support netstandard2.0 — no condition needed -->
    <PackageReference Include="AWSSDK.Rekognition" Version="3.7.400.129" />
    <PackageReference Include="AWSSDK.S3" Version="3.7.416.5" />
    <PackageReference Include="Magick.NET-Q8-AnyCPU" Version="14.15.0" />
    <!-- Microsoft.Extensions and Cryptography packages support netstandard2.0 — no condition needed -->
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" Version="10.0.14" />
    <!-- Pin transitive System.Security.Cryptography.Pkcs to the net10.0-era version to avoid 9.x CVEs -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.14" />
    <!-- EF Core 10.x only supports net10.0, not netstandard2.0 -->
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.14" Condition="'$(TargetFramework)'=='net10.0'" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.14" Condition="'$(TargetFramework)'=='net10.0'" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.14" Condition="'$(TargetFramework)'=='net10.0'" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Bookstore.Domain\Bookstore.Domain.csproj" />
  </ItemGroup>

</Project>
