@model Bookstore.Web.ViewModel.PaginatedViewModel

@{
    // Paging links must preserve the current filter/sort state (e.g. SearchString, SortBy).
    // The MVC5 version only passed pageIndex, so paging away from a search reset the filter.
    var pageRouteValues = new Dictionary<string, object>(StringComparer.OrdinalIgnoreCase);

    foreach (var query in ViewContext.HttpContext.Request.Query)
    {
        if (string.Equals(query.Key, "pageIndex", StringComparison.OrdinalIgnoreCase)) continue;

        var value = query.Value.ToString();
        if (!string.IsNullOrEmpty(value)) pageRouteValues[query.Key] = value;
    }

    foreach (var routeValue in Model.RouteData)
    {
        pageRouteValues[routeValue.Key] = routeValue.Value;
    }

    Func<int, RouteValueDictionary> routeValuesForPage = page =>
    {
        var values = new RouteValueDictionary();
        foreach (var item in pageRouteValues) values[item.Key] = item.Value;
        values["pageIndex"] = page;
        return values;
    };
}

<nav aria-label="Page navigation example">
    <ul class="pagination mb-0">
        <li class="page-item @(Model.HasPreviousPage ? "" : "disabled")">
            @Html.ActionLink("Previous", "Index", routeValuesForPage(Model.PageIndex - 1), new { @class = "page-link" })

        </li>

        @foreach (var button in Model.PaginationButtons)
        {
            <li class="page-item @(Model.PageIndex == button ? "disabled" : "")">
                @Html.ActionLink(button.ToString(), "Index", routeValuesForPage(button), new { @class = "page-link" })
            </li>
        }

        <li class="page-item @(Model.HasNextPage ? "" : "disabled")">
            @Html.ActionLink("Next", "Index", routeValuesForPage(Model.PageIndex + 1), new { @class = "page-link" })
        </li>
    </ul>
</nav>
