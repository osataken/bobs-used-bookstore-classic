@{
    ViewData["Title"] = "Error";
}

@* The original markup linked /Content/css/Error/index.css, which does not exist anywhere in the
   repository (it 404'd on .NET Framework too) and sat in an invalid nested <head> inside the
   layout body, so the dead reference is dropped. *@

<div class="container">
    <div class="row">
        <div class="col-md-12">
            <div class="error-template err-text">
                <h1>
                    Oops!
                </h1>
                <h2 class="err-text">
                    Error Code @ViewData["StatusCode"]

                </h2>
                <div class="err-text">

                    Sorry, an error has occurred
                </div>
                <div class="error-actions">
                    <a href="javascript:history.go(-1)" class="errbutton" style="color:white;">
                        <span class=" text-white "></span>
                        Take Me Back
                    </a>
                    <a asp-area="" asp-action="Index" asp-controller="Home" class="errbutton" style="color:white;">
                        <span class=" text-white err-text"></span>
                        Home
                    </a>

                </div>
            </div>
        </div>
    </div>
</div>