<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Platforms>AnyCPU</Platforms>
    <RootNamespace>Bookstore.Web</RootNamespace>
    <AssemblyName>Bookstore.Web</AssemblyName>
    <!-- Assembly metadata carried over from the deleted Properties/AssemblyInfo.cs -->
    <AssemblyTitle>Bookstore.Web</AssemblyTitle>
    <Company>Organization</Company>
    <Product>Bookstore.Web</Product>
    <Copyright>Copyright © Organization 2023</Copyright>
    <Version>1.0.0.0</Version>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
  </PropertyGroup>

  <ItemGroup>
    <!-- AWS SDK -->
    <PackageReference Include="AWSSDK.CloudWatchLogs" Version="3.7.410.17" />
    <PackageReference Include="AWSSDK.Rekognition" Version="3.7.400.129" />
    <PackageReference Include="AWSSDK.S3" Version="3.7.416.5" />
    <PackageReference Include="AWSSDK.SimpleSystemsManagement" Version="3.7.404.10" />

    <!-- Logging -->
    <PackageReference Include="NLog" Version="5.4.0" />
    <PackageReference Include="NLog.Extensions.Logging" Version="5.3.15" />
    <PackageReference Include="AWS.Logger.NLog" Version="3.3.4" />

    <!-- Authentication -->
    <PackageReference Include="Microsoft.AspNetCore.Authentication.OpenIdConnect" Version="10.0.0" />

    <!-- EF Core -->
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.0" />

    <!-- Tag Helpers / Razor -->
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Razor.RuntimeCompilation" Version="10.0.0" />
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.14" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Bookstore.Common\Bookstore.Common.csproj" />
    <ProjectReference Include="..\Bookstore.Data\Bookstore.Data.csproj" />
    <ProjectReference Include="..\Bookstore.Domain\Bookstore.Domain.csproj" />
  </ItemGroup>

  <!-- Trimming descriptor: preserves MetricsEventSource.GetInstance, which is only
       reached via reflection. Honoured when the app is published trimmed. -->
  <ItemGroup>
    <TrimmerRootDescriptor Include="ILLink/ILLink.Descriptors.LibraryBuild.xml" />
  </ItemGroup>

  <!-- Static file content is included automatically by the SDK Web glob -->
</Project>
