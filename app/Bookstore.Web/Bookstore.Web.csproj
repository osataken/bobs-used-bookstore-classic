<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <Deterministic>true</Deterministic>
    <Company>Organization</Company>
    <Product>BobsBookstoreClassic.Web</Product>
    <AssemblyTitle>BobsBookstoreClassic.Web</AssemblyTitle>
    <Copyright>Copyright © Organization 2023</Copyright>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Autofac" Version="8.2.1" />
    <PackageReference Include="Autofac.Extensions.DependencyInjection" Version="10.0.0" />
    <PackageReference Include="AWSSDK.S3" Version="3.7.511.8" />
    <PackageReference Include="AWSSDK.Rekognition" Version="3.7.502.58" />
    <PackageReference Include="AWSSDK.SimpleSystemsManagement" Version="3.7.505.15" />
    <PackageReference Include="AWSSDK.Extensions.NETCore.Setup" Version="3.7.400.2" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.13" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.OpenIdConnect" Version="10.0.13" />
    <PackageReference Include="NLog.Web.AspNetCore" Version="5.5.0" />
    <PackageReference Include="AWS.Logger.NLog" Version="3.3.4" />
    <!-- Microsoft.Extensions.Configuration.Json / .EnvironmentVariables and
         Microsoft.AspNetCore.Authentication.Cookies are provided by the
         Microsoft.AspNetCore.App shared framework (NU1510) - no PackageReference needed. -->
    <!-- Pinned above the version brought in transitively by Microsoft.Data.SqlClient,
         which carries a known high severity advisory (GHSA-846f-f764-76mx). -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Bookstore.Common/Bookstore.Common.csproj" />
    <ProjectReference Include="../Bookstore.Data/Bookstore.Data.csproj" />
    <ProjectReference Include="../Bookstore.Domain/Bookstore.Domain.csproj" />
  </ItemGroup>

</Project>
