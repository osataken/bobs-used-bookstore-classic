<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Bookstore.Web</RootNamespace>
    <AssemblyName>Bookstore.Web</AssemblyName>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <Company>Organization</Company>
    <Product>BobsBookstoreClassic.Web</Product>
    <AssemblyTitle>Bookstore.Web</AssemblyTitle>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <Version>1.0.0</Version>
    <Copyright>Copyright © Organization 2023</Copyright>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Autofac" Version="9.3.4" />
    <PackageReference Include="Autofac.Extensions.DependencyInjection" Version="11.0.2" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.OpenIdConnect" Version="10.0.13" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.13" />
    <PackageReference Include="Microsoft.IdentityModel.Protocols.OpenIdConnect" Version="8.23.0" />
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="8.23.0" />
    <PackageReference Include="NLog.Web.AspNetCore" Version="6.2.2" />
    <PackageReference Include="NLog.Extensions.Logging" Version="6.2.2" />
    <PackageReference Include="AWS.Logger.NLog" Version="5.0.1" />
    <PackageReference Include="AWSSDK.Core" Version="4.0.102.13" />
    <PackageReference Include="AWSSDK.S3" Version="4.0.104.6" />
    <PackageReference Include="AWSSDK.Rekognition" Version="4.0.101.7" />
    <PackageReference Include="AWSSDK.SimpleSystemsManagement" Version="4.0.104.6" />
    <PackageReference Include="AWSSDK.CloudWatchLogs" Version="4.0.106.1" />
    <!-- Transitive dependency of the AWS SDK; pinned forward past the versions with
         known vulnerabilities (NU1902 / NU1903), matching Bookstore.Data. -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Bookstore.Common\Bookstore.Common.csproj" />
    <ProjectReference Include="..\Bookstore.Data\Bookstore.Data.csproj" />
    <ProjectReference Include="..\Bookstore.Domain\Bookstore.Domain.csproj" />
  </ItemGroup>

</Project>
